#!/usr/bin/perl -w
use lib "/usr/local/netfpga/lib/Perl5";
use strict;

my $IDS_INPUT_HIGH_REG = 0x2000300;
my $IDS_INPUT_LOW_REG = 0x2000304;
my $IDS_INPUT_REVERSED_HIGH_REG = 0x2000308;
my $IDS_INPUT_REVERSED_LOW_REG = 0x200030c;

sub regwrite {
   my( $addr, $value ) = @_;
   my $cmd = sprintf( "regwrite $addr 0x%08x", $value );
   my $result = `$cmd`;
   # print "Ran command '$cmd' and got result '$result'\n";
}

sub regread {
   my( $addr ) = @_;
   my $cmd = sprintf( "regread $addr" );
   my @out = `$cmd`;
   my $result = $out[0];
   if ( $result =~ m/Reg (0x[0-9a-f]+) \((\d+)\):\s+(0x[0-9a-f]+) \((\d+)\)/ ) {
      $result = $3;
   }
   return $result;
}

sub idsreset {
   regwrite( $IDS_INPUT_HIGH_REG, 0x00000000 );
   regwrite( $IDS_INPUT_LOW_REG, 0x00000000 );
}

sub write_pattern {
   my($hi, $lo) = @_;
   regwrite($IDS_INPUT_HIGH_REG, $hi);
   regwrite($IDS_INPUT_LOW_REG, $lo);
}

# Turns an ascii string into a (pattern_hi,pattern_lo) list
sub pattern_from_ascii {
   my( $patstr ) = @_;
   my @chars = split(//, $patstr);
   my @ints = map {  ord( $_ ) } @chars;
   my $validBytes = $#ints + 1;
   my $hi = 0;
   my $lo = 0;
   for (my $i = 0; $i <= 6; $i++) {
      if ($i < $validBytes) {
         my $bit = 1 << (6 - $i);
         # print "Setting mask bit $bit for byte $i\n";
         $hi |= ($bit << 24);
         if ($i <= 2) {
            $hi |= ($ints[$i] << (8 * (2 - $i)));
         } else {
            my $pos = $i - 3;
            $lo |= ($ints[$i] << (8 * (3 - $pos)));
         }
      }
   }
   return ($hi, $lo);
}

sub usage {
   print "Usage: idsreg <cmd> <cmd options>\n";
   print "  Commands:\n";
   print "    reset                resets the matches counter\n";
   print "    input <string>       set a pattern from ASCII\n";
   print "    matches              displays the matches register\n";
}

my $numargs = $#ARGV + 1;
if( $numargs < 1 ) {
   usage();
   exit(1);
}
my $cmd = $ARGV[0];
if ($cmd eq "reset") {
   idsreset();
} elsif ($cmd eq "input") {
   if ($numargs < 2) {
      usage();
      exit(1);
   }
   my $str = $ARGV[1];
   my($hi, $lo) = pattern_from_ascii($str);
   printf("Setting input registers hi=0x%08x, lo=0x%08x\n", $hi, $lo);
   write_pattern($hi, $lo);   
} elsif ($cmd eq "allregs") {
   print "INPUT_HIGH:    ", regread( $IDS_INPUT_HIGH_REG ), "\n";
   print "INPUT_LOW: ", regread( $IDS_INPUT_LOW_REG ), "\n";
   print "INPUT_REVERSED_HIGH: ", regread( $IDS_INPUT_REVERSED_HIGH_REG ), "\n";
   print "INPUT_REVERSED_LOW:    ", regread( $IDS_INPUT_REVERSED_LOW_REG ), "\n";
} else {
   print "Unrecognized command $cmd\n";
   usage();
   exit(1)
}

